-- === SISTEMA TOUCH FLING ===
local TouchFlingSystem = {Active = false, Connection = nil}

function TouchFlingSystem:Start()
    if self.Active then return end
    self.Active = true
    local movel = 0.1
    
    self.Connection = RunService.Heartbeat:Connect(function()
        if not Settings.TouchFlingEnabled then self:Stop() return end
        local character = LP.Character
        local hrp = character and character:FindFirstChild("HumanoidRootPart")
        
        if hrp then
            local currentVel = hrp.Velocity
            hrp.Velocity = currentVel * 10000 + Vector3.new(0, 10000, 0)
            RunService.RenderStepped:Wait()
            hrp.Velocity = currentVel
            RunService.Stepped:Wait()
            hrp.Velocity = currentVel + Vector3.new(0, movel, 0)
            movel = -movel
        end
    end)
end

function TouchFlingSystem:Stop()
    self.Active = false
    if self.Connection then self.Connection:Disconnect(); self.Connection = nil end
end

function TouchFlingSystem:Toggle(state)
    Settings.TouchFlingEnabled = state
    if state then self:Start() else self:Stop() end
end

-- === SISTEMA INVISIBILITY (BitingTheDust Adapted) ===
local InvisibilitySystem = {
    FakeCharacter = nil,
    RealCharacter = nil,
    Part = nil,
    PseudoAnchor = nil,
    CanInvis = true,
    IsInvisible = false,
    Connections = {}
}

function InvisibilitySystem:Setup()
    self.RealCharacter = LP.Character or LP.CharacterAdded:Wait()
    self.RealCharacter.Archivable = true
    self.FakeCharacter = self.RealCharacter:Clone()
    
    self.Part = Instance.new("Part", workspace)
    self.Part.Anchored = true
    self.Part.Size = Vector3.new(200, 1, 200)
    self.Part.CFrame = CFrame.new(0, -500, 0)
    self.Part.CanCollide = true
    
    self.FakeCharacter.Parent = workspace
    if self.FakeCharacter:FindFirstChild("HumanoidRootPart") then
        self.FakeCharacter.HumanoidRootPart.CFrame = self.Part.CFrame * CFrame.new(0, 5, 0)
    end

    for _, v in pairs(self.RealCharacter:GetChildren()) do
        if v:IsA("LocalScript") then
            local clone = v:Clone()
            clone.Disabled = true
            clone.Parent = self.FakeCharacter
        end
    end

    -- Transparencia
    for _, v in pairs(self.FakeCharacter:GetDescendants()) do
        if v:IsA("BasePart") then v.Transparency = 0.7 end
    end

    self.PseudoAnchor = self.FakeCharacter:FindFirstChild("HumanoidRootPart")

    -- Muerte
    local hum = self.RealCharacter:FindFirstChildOfClass("Humanoid")
    if hum then
        table.insert(self.Connections, hum.Died:Connect(function()
            if self.RealCharacter then self.RealCharacter:Destroy() end
            if self.FakeCharacter then self.FakeCharacter:Destroy() end
        end))
    end
end

function InvisibilitySystem:Toggle(state)
    Settings.InvisibilityEnabled = state
    if state then
        if not self.FakeCharacter or not self.FakeCharacter.Parent then
            self:Setup()
        end
        if not self.IsInvisible and self.RealCharacter and self.FakeCharacter then
            local rHrp = self.RealCharacter:FindFirstChild("HumanoidRootPart")
            local fHrp = self.FakeCharacter:FindFirstChild("HumanoidRootPart")
            local rHum = self.RealCharacter:FindFirstChildOfClass("Humanoid")
            local fHum = self.FakeCharacter:FindFirstChildOfClass("Humanoid")

            if rHrp and fHrp and rHum and fHum then
                local StoredCF = rHrp.CFrame
                rHrp.CFrame = fHrp.CFrame
                fHrp.CFrame = StoredCF
                rHum:UnequipTools()
                LP.Character = self.FakeCharacter
                Camera.CameraSubject = fHum
                self.PseudoAnchor = rHrp
                for _, v in pairs(self.FakeCharacter:GetChildren()) do
                    if v:IsA("LocalScript") then v.Disabled = false end
                end
                self.IsInvisible = true
            end
        end
    else
        if self.IsInvisible and self.RealCharacter and self.FakeCharacter then
            local rHrp = self.RealCharacter:FindFirstChild("HumanoidRootPart")
            local fHrp = self.FakeCharacter:FindFirstChild("HumanoidRootPart")
            local rHum = self.RealCharacter:FindFirstChildOfClass("Humanoid")
            local fHum = self.FakeCharacter:FindFirstChildOfClass("Humanoid")

            if rHrp and fHrp and rHum and fHum then
                local StoredCF = fHrp.CFrame
                fHrp.CFrame = rHrp.CFrame
                rHrp.CFrame = StoredCF
                fHum:UnequipTools()
                LP.Character = self.RealCharacter
                Camera.CameraSubject = rHum
                self.PseudoAnchor = fHrp
                for _, v in pairs(self.FakeCharacter:GetChildren()) do
                    if v:IsA("LocalScript") then v.Disabled = true end
                end
                self.IsInvisible = false
            end
        end
    end
end

RunService.RenderStepped:Connect(function()
    if InvisibilitySystem.PseudoAnchor and InvisibilitySystem.Part then
        InvisibilitySystem.PseudoAnchor.CFrame = InvisibilitySystem.Part.CFrame * CFrame.new(0, 5, 0)
    end
end)

