        resetCamera(); stopAttack(); pages["SALA_OPTS"].Visible = false; pages["SALA"].Visible = true 
    end, false, true).TextLabel.TextColor3 = themeColor

    createRow("Espectar", pages["SALA_OPTS"], true, nil, spectateActive, function(v) spectateActive = v if not v then resetCamera() end end)
    createRow("Teletransportar", pages["SALA_OPTS"], false, nil, nil, teleportToTarget, true, true)

