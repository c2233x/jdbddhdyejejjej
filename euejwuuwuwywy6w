    targetPlayer = p
    pages["SALA"].Visible = false
    pages["SALA_OPTS"].Visible = true

    for _, v in pairs(pages["SALA_OPTS"]:GetChildren()) do if not v:IsA("UIListLayout") then v:Destroy() end end

