    createRow("Activar Fling", pages["SALA_OPTS"], true, nil, flingActive, function(v) 
        if v then lastPos = LP.Character.HumanoidRootPart.CFrame; flingActive, bangActive = true, false else stopAttack() end 
    end)
    createSlider("Fling Power", 1000, 500000, nil, flingRot, pages["SALA_OPTS"], false, function(v) flingRot = v end)

