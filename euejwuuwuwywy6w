    end)
    createSlider("Bang Speed", 10, 100, nil, bangSpeed, pages["SALA_OPTS"], false, function(v) bangSpeed = v end)
    createSlider("Bang Tilt", 0, 90, nil, bangTilt, pages["SALA_OPTS"], false, function(v) bangTilt = v end)
