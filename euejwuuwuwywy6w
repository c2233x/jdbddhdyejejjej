-- === LOOPS DE FÍSICA Y VISUALES ===
local function isVisible(part, char)
    if not Settings.VisibleCheck then return true end
    local params = RaycastParams.new(); params.FilterType = Enum.RaycastFilterType.Exclude; params.FilterDescendantsInstances = {LP.Character, char}
    return workspace:Raycast(Camera.CFrame.Position, (part.Position - Camera.CFrame.Position), params) == nil
end

RunService.RenderStepped:Connect(function()
    if spectateActive and targetPlayer and targetPlayer.Character then
        local tHum = targetPlayer.Character:FindFirstChild("Humanoid")
        if tHum then Camera.CameraType = Enum.CameraType.Custom Camera.CameraSubject = tHum end
    end
    
    if not Running then return end
    updateFOVCircle()
    local center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    local potTarget, lastVal = nil, math.huge

    for _, p in pairs(Players:GetPlayers()) do
        local char = p.Character
        if p ~= LP and char and char:FindFirstChild(Settings.AimPart) and char.Humanoid.Health > 0 then
            local part = char[Settings.AimPart]
            local pos, onscreen = Camera:WorldToViewportPoint(part.Position)
            local mag = (part.Position - LP.Character.HumanoidRootPart.Position).Magnitude
            local isAlly = (p.Team == LP.Team) or (p.TeamColor == LP.TeamColor)
            local isEnemy = not Settings.TeamCheck or not isAlly
            
            if (isEnemy or Settings.ShowAliados) and mag <= Settings.MaxDistance then
                local color = (p == CurrentTarget) and Color3.new(1,1,0) or ((not Settings.TeamCheck) and Color3.new(1,0,0) or (isAlly and Color3.new(0,1,0) or Color3.new(1,0,0)))
                
                -- ESP NOMBRES
                if Settings.ESP_Names and onscreen then
                    if not nms[p] then nms[p] = Drawing.new("Text") nms[p].Center, nms[p].Outline = true, true end
                    nms[p].Visible, nms[p].Color, nms[p].Text, nms[p].Position = true, color, p.Name, Vector2.new(pos.X, pos.Y - 25)
                elseif nms[p] then nms[p].Visible = false end
                
                -- ESP LÍNEAS
                if Settings.ESP_Lines and onscreen then
                    if not lns[p] then lns[p] = Drawing.new("Line") end
                    lns[p].Visible, lns[p].Color, lns[p].From, lns[p].To = true, color, Vector2.new(center.X, Camera.ViewportSize.Y), Vector2.new(pos.X, pos.Y)
                elseif lns[p] then lns[p].Visible = false end
                
                -- ESP CHAMS
                if Settings.ESP_Chams then
                    if not chams[p] then chams[p] = Instance.new("Highlight", CoreGui) end
                    chams[p].Adornee, chams[p].Enabled, chams[p].FillColor = char, true, color
                elseif chams[p] then chams[p].Enabled = false end

                -- DETECCIÓN AIMBOT
                if isEnemy then
                    local sDist = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                    if (Settings.Aim360Total or (onscreen and sDist <= Settings.FOV)) and isVisible(part, char) then
                        local val = (Settings.Priority == "Mira") and sDist or mag
                        if val < lastVal then lastVal, potTarget = val, p end
                    end
                end
            else 
                hideVisuals(p) -- FIX: Ocultar en lugar de destruir
            end
        else 
            hideVisuals(p) -- FIX: Ocultar en lugar de destruir
        end
    end

    if CurrentTarget ~= potTarget and CurrentTarget then pcall(function() CurrentTarget.Character.Head.Anchored = false end) end
    CurrentTarget = potTarget

    -- AIMBOT (Corregido con CFrame.lookAt para más estabilidad)
    if CurrentTarget and Settings.Aimbot then
        local char = CurrentTarget.Character
        local targetPos = char[Settings.AimPart].Position
        local lerpAlpha = Settings.Smoothing == 0 and 1 or (1 - (Settings.Smoothing / 10))
        Camera.CFrame = Camera.CFrame:Lerp(CFrame.lookAt(Camera.CFrame.Position, targetPos), lerpAlpha)
        
        if Settings.VentajaEnabled then
            local function movePart(part) if part and part:IsA("BasePart") then part.Anchored = true part.CanCollide = false part.CFrame = LP.Character.HumanoidRootPart.CFrame * CFrame.new(Settings.OffX, Settings.OffY, Settings.OffZ) end end
            pcall(function() if Settings.VentajaTarget == "Cabeza" then movePart(char:FindFirstChild("Head")) elseif Settings.VentajaTarget == "Torso" then movePart(char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")) elseif Settings.VentajaTarget == "Todo" then for _, v in pairs(char:GetChildren()) do movePart(v) end end end)
        end
        if Settings.AutoShoot and (tick() - lastShot) >= Settings.AutoShootDelay then
            if isVisible(char[Settings.AimPart], char) then
                pcall(function() VIM:SendMouseButtonEvent(0, 0, 0, true, game, 0) task.wait(0.02) VIM:SendMouseButtonEvent(0, 0, 0, false, game, 0) end)
                lastShot = tick()
            end
        end
    end
    
    -- LÓGICA TELEKILL Y FLY
    local char = LP.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    
    if root then
        if Settings.Telekill and CurrentTarget and CurrentTarget.Character and CurrentTarget.Character:FindFirstChild("HumanoidRootPart") then
            -- Si Telekill está encendido, pega a tu jugador al enemigo
            root.Velocity = Vector3.zero
            root.CFrame = CurrentTarget.Character.HumanoidRootPart.CFrame * CFrame.new(0, 0, 3)
        elseif Settings.Fly then
            -- Solo vuela si no está haciendo Telekill
            if not antiGrav or antiGrav.Parent ~= root then
                if antiGrav then antiGrav:Destroy() end
                antiGrav = Instance.new("BodyForce")
                antiGrav.Name = "AntiGravIY"
                local mass = 0
                for _, v in pairs(char:GetChildren()) do if v:IsA("BasePart") then mass = mass + v:GetMass() end end
                antiGrav.Force = Vector3.new(0, mass * workspace.Gravity, 0)
                antiGrav.Parent = root
            end
            root.Velocity = Vector3.new(0, 0, 0)
            root.CFrame = CFrame.new(root.Position, root.Position + Camera.CFrame.LookVector)
            local moveVec = getMoveVector()
            if moveVec.Magnitude > 0 then
                local direction = (Camera.CFrame.LookVector * (moveVec.Z * -1)) + (Camera.CFrame.RightVector * moveVec.X)
                root.CFrame = root.CFrame + (direction * Settings.FlySpeed)
            end
        elseif antiGrav then
            antiGrav:Destroy()
            antiGrav = nil
        end
    end
end)

RunService.Stepped:Connect(function()
    if not Running then return end
    local char = LP.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart")

    if Settings.Noclip then
        for _, part in pairs(char:GetDescendants()) do if part:IsA("BasePart") then part.CanCollide = false end end
    end

    if hum and root and not Settings.Fly and not Settings.Telekill then
        if Settings.SpeedActive then
            local moveVec = getMoveVector()
            if moveVec.Magnitude > 0 then
                local direction = (Camera.CFrame.LookVector * (moveVec.Z * -1)) + (Camera.CFrame.RightVector * moveVec.X)
                direction = Vector3.new(direction.X, 0, direction.Z).Unit
                root.CFrame = root.CFrame + (direction * (Settings.WalkSpeedVal / 45))
            end
        end
        if Settings.JumpActive then
            hum.JumpPower = Settings.JumpPowerVal
            hum.UseJumpPower = true
            if hum.Jump or UIS:IsKeyDown(Enum.KeyCode.Space) then
                root.Velocity = Vector3.new(root.Velocity.X, Settings.JumpPowerVal, root.Velocity.Z)
            end
        end
    end
end)

RunService.Heartbeat:Connect(function()
    if not targetPlayer or not targetPlayer.Character then return end
    local char, tChar = LP.Character, targetPlayer.Character
    local root, tRoot = char and char:FindFirstChild("HumanoidRootPart"), tChar:FindFirstChild("HumanoidRootPart")
    
    if root and tRoot and not root.Anchored then
        local t = tick()
        if flingActive then
            local bf = root:FindFirstChild("FlingForce") or Instance.new("BodyAngularVelocity", root)
            bf.Name = "FlingForce"; bf.MaxTorque = Vector3.new(math.huge, math.huge, math.huge); bf.AngularVelocity = Vector3.new(0, flingRot, 0)
            root.Velocity = Vector3.new(4500, 4500, 4500)
            local fMode = flingModes[flingModeIndex]
            if fMode == "GHOST" then root.CFrame = tRoot.CFrame * CFrame.new(math.sin(t*50)*1.5, 0, math.cos(t*50)*1.5)
            elseif fMode == "TORNADO" then root.CFrame = tRoot.CFrame * CFrame.new(math.sin(t*30)*2.5, 2, math.cos(t*30)*2.5)
            elseif fMode == "MISIL" then root.CFrame = tRoot.CFrame * CFrame.new(0, 0, math.sin(t*40)*3.5)
            elseif fMode == "DEBAJO" then root.CFrame = tRoot.CFrame * CFrame.new(0, -3.8, 0) end
        elseif bangActive then
            root.Velocity = Vector3.zero
            local sin = math.sin(t * bangSpeed)
            local bMode, tilt = bangModes[modeIndex], CFrame.Angles(math.rad(sin * bangTilt), 0, 0)
            if bMode == "ESPALDA" then root.CFrame = tRoot.CFrame * CFrame.new(0, 0, 1.2 + (sin * 0.4)) * tilt
            elseif bMode == "CABEZA" then local head = tChar:FindFirstChild("Head") if head then root.CFrame = CFrame.lookAt(head.Position + (head.CFrame.LookVector * 1.1), head.Position) * tilt end
            elseif bMode == "CABEZA ALTO" then local head = tChar:FindFirstChild("Head") if head then root.CFrame = CFrame.lookAt(head.Position + (head.CFrame.LookVector * 1.1) + Vector3.new(0,1.5,0), head.Position) * tilt end
            elseif bMode == "PISO (ESPALDA)" then root.CFrame = tRoot.CFrame * CFrame.new(0, -2.4, 1.2) * CFrame.Angles(math.rad(90), 0, 0) * tilt end
        end
    end
end)
