local antiGrav = nil
local function getMoveVector()
    local PlayerModule = LP.PlayerScripts:FindFirstChild("PlayerModule")
    if PlayerModule then return require(PlayerModule):GetControls():GetMoveVector() end
    return Vector3.new(0,0,0)
end

local function isVisible(part, char)
    if not Settings.VisibleCheck then return true end
    local params = RaycastParams.new(); params.FilterType = Enum.RaycastFilterType.Exclude; params.FilterDescendantsInstances = {LP.Character, char}
    return workspace:Raycast(Camera.CFrame.Position, (part.Position - Camera.CFrame.Position), params) == nil
end

RunService.RenderStepped:Connect(function()
    Camera = workspace.CurrentCamera
    if not Camera then return end

    if spectateActive and targetPlayer and targetPlayer.Character then
        local tHum = targetPlayer.Character:FindFirstChild("Humanoid")
        if tHum then Camera.CameraType = Enum.CameraType.Custom Camera.CameraSubject = tHum end
    end

    if not Running then return end
    updateFOVCircle()
    local center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    local potTarget, lastVal = nil, math.huge

    for _, p in pairs(Players:GetPlayers()) do
        local char = p.Character
        if p ~= LP and char and char:FindFirstChild(Settings.AimPart) and char.Humanoid.Health > 0 then
            local part = char[Settings.AimPart]
            local pos, onscreen = Camera:WorldToViewportPoint(part.Position)
            local mag = (part.Position - LP.Character.HumanoidRootPart.Position).Magnitude
            local isAlly = (p.Team == LP.Team) or (p.TeamColor == LP.TeamColor)
            local isEnemy = not Settings.TeamCheck or not isAlly

            if (isEnemy or Settings.ShowAliados) and mag <= Settings.MaxDistance then
                local color = (p == CurrentTarget) and Color3.new(1,1,0) or ((not Settings.TeamCheck) and Color3.new(1,0,0) or (isAlly and Color3.new(0,1,0) or Color3.new(1,0,0)))

                if Settings.ESP_Highlight then
                    if not highlightsTbl[p] or not highlightsTbl[p].Parent then
                        pcall(function()
                            local h = Instance.new("Highlight")
                            h.Name = "ESP_HL_" .. p.Name
                            h.FillTransparency = 1
                            h.OutlineTransparency = 0
                            h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                            h.Parent = CoreGui
                            highlightsTbl[p] = h
                        end)
                    end
                    if highlightsTbl[p] then
                        pcall(function()
                            highlightsTbl[p].Enabled = true
                            highlightsTbl[p].OutlineColor = color
                            highlightsTbl[p].Adornee = char
                        end)
                    end
                else
                    if highlightsTbl[p] then
                        pcall(function() highlightsTbl[p]:Destroy() end)
                        highlightsTbl[p] = nil
                    end
                end

                if Settings.ESP_Chams then
                    if not chamsTbl[p] or not chamsTbl[p].Parent then
                        pcall(function()
                            local c = Instance.new("Highlight")
                            c.Name = "ESP_CH_" .. p.Name
                            c.FillTransparency = 0.5
                            c.OutlineTransparency = 1
                            c.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                            c.Parent = CoreGui
                            chamsTbl[p] = c
                        end)
                    end
                    if chamsTbl[p] then
                        pcall(function()
                            chamsTbl[p].Enabled = true
                            chamsTbl[p].FillColor = color
                            chamsTbl[p].Adornee = char
                        end)
                    end
                else
                    if chamsTbl[p] then
                        pcall(function() chamsTbl[p]:Destroy() end)
                        chamsTbl[p] = nil
                    end
                end

                local head = char:FindFirstChild("Head")
                local root = char:FindFirstChild("HumanoidRootPart")
                
                if head and root and onscreen then
                    local headPos = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 1.5, 0))
                    local bottomPos = Camera:WorldToViewportPoint(root.Position - Vector3.new(0, 3.5, 0))
                    local boxHeight = bottomPos.Y - headPos.Y
                    local boxWidth = boxHeight / 2

                    if Settings.ESP_Names then
                        if not nms[p] then 
                            local txt = Instance.new("TextLabel", espGui)
                            txt.BackgroundTransparency = 1
                            txt.Font = Enum.Font.GothamBold
                            txt.TextSize = 13
                            txt.TextStrokeTransparency = 0
                            txt.AnchorPoint = Vector2.new(0.5, 1)
                            txt.Size = UDim2.new(0, 150, 0, 20)
                            nms[p] = txt
                        end
                        nms[p].Visible = true
                        nms[p].TextColor3 = color
                        nms[p].Text = p.Name
                        nms[p].Position = UDim2.new(0, pos.X, 0, headPos.Y - 5)
                    elseif nms[p] then 
                        nms[p].Visible = false
                    end

                    if Settings.ESP_Distance then
                        if not distLbls[p] then
                            local lbl = Instance.new("TextLabel", espGui)
                            lbl.BackgroundTransparency = 1
                            lbl.Font = Enum.Font.GothamBold
                            lbl.TextSize = 11
                            lbl.TextStrokeTransparency = 0
                            lbl.AnchorPoint = Vector2.new(0.5, 0)
                            lbl.Size = UDim2.new(0, 100, 0, 15)
                            distLbls[p] = lbl
                        end
                        if distLbls[p] then
                            pcall(function()
                                distLbls[p].Visible = true
                                distLbls[p].TextColor3 = Color3.new(0.8, 0.8, 0.8)
                                distLbls[p].Text = "[" .. math.floor(mag * 0.28) .. "m]"
                                distLbls[p].Position = UDim2.new(0, pos.X, 0, bottomPos.Y + 2)
                            end)
                        end
                    elseif distLbls[p] then
                        pcall(function() distLbls[p].Visible = false end)
                    end

                    if Settings.ESP_Health then
                        local hp = char.Humanoid.Health
                        local maxHp = char.Humanoid.MaxHealth
                        local hpPct = math.clamp(hp / maxHp, 0, 1)
                        
                        if not healthBgs[p] then
                            local bg = Instance.new("Frame", espGui)
                            bg.BackgroundColor3 = Color3.new(0,0,0)
                            bg.BorderSizePixel = 0
                            bg.AnchorPoint = Vector2.new(1, 0)
                            
                            local fill = Instance.new("Frame", bg)
                            fill.BorderSizePixel = 0
                            fill.AnchorPoint = Vector2.new(0, 1)
                            fill.Position = UDim2.new(0, 0, 1, 0)
                            
                            local txt = Instance.new("TextLabel", espGui)
                            txt.BackgroundTransparency = 1
                            txt.Font = Enum.Font.GothamBold
                            txt.TextSize = 10
                            txt.TextStrokeTransparency = 0
                            txt.AnchorPoint = Vector2.new(1, 0.5)
                            
                            healthBgs[p] = bg
                            healthFills[p] = fill
                            healthTxts[p] = txt
                        end
                        
                        if healthBgs[p] then
                            pcall(function()
                                healthBgs[p].Visible = true
                                healthTxts[p].Visible = true
                                
                                local bHeight = math.max(10, boxHeight)
                                healthBgs[p].Size = UDim2.new(0, 3, 0, bHeight)
                                healthBgs[p].Position = UDim2.new(0, headPos.X - (boxWidth/2) - 4, 0, headPos.Y)
                                
                                healthFills[p].Size = UDim2.new(1, 0, hpPct, 0)
                                healthFills[p].BackgroundColor3 = Color3.new(1 - hpPct, hpPct, 0)
                                
                                healthTxts[p].Text = tostring(math.floor(hp))
                                healthTxts[p].TextColor3 = Color3.new(1 - hpPct, hpPct, 0)
                                healthTxts[p].Position = UDim2.new(0, headPos.X - (boxWidth/2) - 9, 0, headPos.Y + (bHeight * (1 - hpPct)))
                            end)
                        end
                    elseif healthBgs[p] then
                        pcall(function() 
                            healthBgs[p].Visible = false
                            healthTxts[p].Visible = false 
                        end)
                    end
                else
                    if nms[p] then nms[p].Visible = false end
                    if distLbls[p] then distLbls[p].Visible = false end
                    if healthBgs[p] then healthBgs[p].Visible = false healthTxts[p].Visible = false end
                end

                if Settings.ESP_Lines and onscreen then
                    if not lns[p] then 
                        local line = Instance.new("Frame", espGui)
                        line.BorderSizePixel = 0
                        line.AnchorPoint = Vector2.new(0.5, 0.5)
                        lns[p] = line
                    end
                    lns[p].Visible = true
                    lns[p].BackgroundColor3 = color
                    
                    local startPos = Vector2.new(center.X, Camera.ViewportSize.Y)
                    local endPos = Vector2.new(pos.X, pos.Y)
                    local distance = (startPos - endPos).Magnitude
                    local midPoint = (startPos + endPos) / 2
                    local angle = math.atan2(endPos.Y - startPos.Y, endPos.X - startPos.X)
                    
                    lns[p].Size = UDim2.new(0, distance, 0, 1.5)
                    lns[p].Position = UDim2.new(0, midPoint.X, 0, midPoint.Y)
                    lns[p].Rotation = math.deg(angle)
                elseif lns[p] then 
                    lns[p].Visible = false
                end

                if isEnemy then
                    local sDist = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                    if (Settings.Aim360Total or (onscreen and sDist <= Settings.FOV)) and isVisible(part, char) then
                        local val = (Settings.Priority == "Mira") and sDist or mag
                        if val < lastVal then lastVal, potTarget = val, p end
                    end
                end
            else 
                hideVisuals(p) 
                if highlightsTbl[p] then pcall(function() highlightsTbl[p]:Destroy() end) highlightsTbl[p] = nil end
                if chamsTbl[p] then pcall(function() chamsTbl[p]:Destroy() end) chamsTbl[p] = nil end
            end
        else 
            hideVisuals(p) 
            if highlightsTbl[p] then pcall(function() highlightsTbl[p]:Destroy() end) highlightsTbl[p] = nil end
            if chamsTbl[p] then pcall(function() chamsTbl[p]:Destroy() end) chamsTbl[p] = nil end
        end
    end

    if CurrentTarget ~= potTarget and CurrentTarget then pcall(function() CurrentTarget.Character.Head.Anchored = false end) end
    CurrentTarget = potTarget

    if CurrentTarget and Settings.Aimbot then
        local char = CurrentTarget.Character
        local targetPos = char[Settings.AimPart].Position
        local lerpAlpha = Settings.Smoothing == 0 and 1 or (1 - (Settings.Smoothing / 10))
        Camera.CFrame = Camera.CFrame:Lerp(CFrame.lookAt(Camera.CFrame.Position, targetPos), lerpAlpha)

        if Settings.VentajaEnabled then
            local function movePart(part) if part and part:IsA("BasePart") then part.Anchored = true part.CanCollide = false part.CFrame = LP.Character.HumanoidRootPart.CFrame * CFrame.new(Settings.OffX, Settings.OffY, Settings.OffZ) end end
            pcall(function() if Settings.VentajaTarget == "Cabeza" then movePart(char:FindFirstChild("Head")) elseif Settings.VentajaTarget == "Torso" then movePart(char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")) elseif Settings.VentajaTarget == "Todo" then for _, v in pairs(char:GetChildren()) do movePart(v) end end end)
        end

        local isTargetVisible = isVisible(char[Settings.AimPart], char)
        if Settings.AutoShoot and Settings.TouchX > 0 and isTargetVisible then
            if Settings.TouchMode == "CLICK" then
                if (tick() - lastShot) >= Settings.AutoShootDelay then
                    pcall(function() 
                        VIM:SendTouchEvent(touchId, 0, Settings.TouchX, Settings.TouchY) 
                        task.wait(0.03) 
                        VIM:SendTouchEvent(touchId, 2, Settings.TouchX, Settings.TouchY) 
                    end)
                    lastShot = tick()
                end
            elseif Settings.TouchMode == "HOLD" then
                if not isHolding then
                    pcall(function() VIM:SendTouchEvent(touchId, 0, Settings.TouchX, Settings.TouchY) end)
                    isHolding = true
                end
            end
        else
            if isHolding then
                pcall(function() VIM:SendTouchEvent(touchId, 2, Settings.TouchX, Settings.TouchY) end)
                isHolding = false
            end
        end
    else
        if isHolding then
            pcall(function() VIM:SendTouchEvent(touchId, 2, Settings.TouchX, Settings.TouchY) end)
            isHolding = false
        end
    end

    local char = LP.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")

    if root then
        if Settings.Telekill and CurrentTarget and CurrentTarget.Character and CurrentTarget.Character:FindFirstChild("HumanoidRootPart") then
            root.Velocity = Vector3.zero
            root.CFrame = CurrentTarget.Character.HumanoidRootPart.CFrame * CFrame.new(0, 0, 3)
        elseif Settings.Fly then
            if not antiGrav or antiGrav.Parent ~= root then
                if antiGrav then antiGrav:Destroy() end
                antiGrav = Instance.new("BodyForce")
                antiGrav.Name = "AntiGravIY"
                local mass = 0
                for _, v in pairs(char:GetChildren()) do if v:IsA("BasePart") then mass = mass + v:GetMass() end end
                antiGrav.Force = Vector3.new(0, mass * workspace.Gravity, 0)
                antiGrav.Parent = root
            end
            root.Velocity = Vector3.new(0, 0, 0)
            root.CFrame = CFrame.new(root.Position, root.Position + Camera.CFrame.LookVector)
            local moveVec = getMoveVector()
            if moveVec.Magnitude > 0 then
                local direction = (Camera.CFrame.LookVector * (moveVec.Z * -1)) + (Camera.CFrame.RightVector * moveVec.X)
                root.CFrame = root.CFrame + (direction * Settings.FlySpeed)
            end
        elseif antiGrav then
            antiGrav:Destroy()
            antiGrav = nil
        end
    end
end)

RunService.Stepped:Connect(function()
    if not Running then return end
    local char = LP.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart")

    if Settings.Noclip then
        for _, part in pairs(char:GetDescendants()) do if part:IsA("BasePart") then part.CanCollide = false end end
    end

    if hum and root and not Settings.Fly and not Settings.Telekill then
        if Settings.SpeedActive then
            local moveVec = getMoveVector()
            if moveVec.Magnitude > 0 then
                local direction = (Camera.CFrame.LookVector * (moveVec.Z * -1)) + (Camera.CFrame.RightVector * moveVec.X)
                direction = Vector3.new(direction.X, 0, direction.Z).Unit
                root.CFrame = root.CFrame + (direction * (Settings.WalkSpeedVal / 45))
            end
        end
        if Settings.JumpActive then
            hum.JumpPower = Settings.JumpPowerVal
            hum.UseJumpPower = true
            if hum.Jump or UIS:IsKeyDown(Enum.KeyCode.Space) then
                root.Velocity = Vector3.new(root.Velocity.X, Settings.JumpPowerVal, root.Velocity.Z)
            end
        end
    end
end)

RunService.Heartbeat:Connect(function()
    if not targetPlayer or not targetPlayer.Character then return end
    local char, tChar = LP.Character, targetPlayer.Character
    local root, tRoot = char and char:FindFirstChild("HumanoidRootPart"), tChar:FindFirstChild("HumanoidRootPart")

    if root and tRoot and not root.Anchored then
        local t = tick()
        if flingActive then
            local bf = root:FindFirstChild("FlingForce") or Instance.new("BodyAngularVelocity", root)
            bf.Name = "FlingForce"; bf.MaxTorque = Vector3.new(math.huge, math.huge, math.huge); bf.AngularVelocity = Vector3.new(0, flingRot, 0)
            root.Velocity = Vector3.new(4500, 4500, 4500)
            local fMode = flingModes[flingModeIndex]
            if fMode == "GHOST" then root.CFrame = tRoot.CFrame * CFrame.new(math.sin(t*50)*1.5, 0, math.cos(t*50)*1.5)
            elseif fMode == "TORNADO" then root.CFrame = tRoot.CFrame * CFrame.new(math.sin(t*30)*2.5, 2, math.cos(t*30)*2.5)
            elseif fMode == "MISIL" then root.CFrame = tRoot.CFrame * CFrame.new(0, 0, math.sin(t*40)*3.5)
            elseif fMode == "DEBAJO" then root.CFrame = tRoot.CFrame * CFrame.new(0, -3.8, 0) end
        elseif bangActive then
            root.Velocity = Vector3.zero
            local sin = math.sin(t * bangSpeed)
            local bMode, tilt = bangModes[modeIndex], CFrame.Angles(math.rad(sin * bangTilt), 0, 0)
            if bMode == "ESPALDA" then root.CFrame = tRoot.CFrame * CFrame.new(0, 0, 1.2 + (sin * 0.4)) * tilt
            elseif bMode == "CABEZA" then local head = tChar:FindFirstChild("Head") if head then root.CFrame = CFrame.lookAt(head.Position + (head.CFrame.LookVector * 1.1), head.Position) * tilt end
            elseif bMode == "CABEZA ALTO" then local head = tChar:FindFirstChild("Head") if head then root.CFrame = CFrame.lookAt(head.Position + (head.CFrame.LookVector * 1.1) + Vector3.new(0,1.5,0), head.Position) * tilt end
            elseif bMode == "PISO (ESPALDA)" then root.CFrame = tRoot.CFrame * CFrame.new(0, -1.7, 1.2) * CFrame.Angles(math.rad(90), 0, 0) * tilt end
        end
    end
end)

