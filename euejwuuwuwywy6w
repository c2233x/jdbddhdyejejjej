local function createRow(text, parent, isToggle, stateObj, stateKey, callback, hasArrow, underlined)
    local btn = Instance.new("TextButton", parent)
    btn.Size = UDim2.new(1, 0, 0, 35); btn.BackgroundColor3 = Color3.new(0,0,0)
    btn.BackgroundTransparency = 0.7; btn.Text = ""; btn.BorderSizePixel = 0
    if underlined then
        local line = Instance.new("Frame", btn)
        line.Size = UDim2.new(0.9, 0, 0, 1); line.Position = UDim2.new(0.05, 0, 1, -1)
        line.BackgroundColor3 = themeColor; line.BackgroundTransparency = 0.4; line.BorderSizePixel = 0
    end
    local lbl = Instance.new("TextLabel", btn)
    lbl.Size = UDim2.new(1, -45, 1, 0); lbl.Position = UDim2.new(0, 15, 0, 0)
    lbl.BackgroundTransparency = 1; lbl.Text = text; lbl.TextColor3 = Color3.new(1,1,1)
    lbl.Font = "Gotham"; lbl.TextSize = 11; lbl.TextXAlignment = "Left"
    
    if isToggle then
        local st = Instance.new("TextLabel", btn)
        st.Size = UDim2.new(0, 30, 1, 0); st.Position = UDim2.new(1, -40, 0, 0)
        st.BackgroundTransparency = 1; st.Font = "GothamBold"; st.TextSize = 10
        
        -- Determinamos si el estado inicial es de una tabla o un valor directo
        local active = (stateObj and stateObj[stateKey]) or (not stateObj and stateKey) or false
        
        local function updateVisuals(v)
            st.Text = v and "ON" or "OFF"
            st.TextColor3 = v and themeColor or Color3.fromRGB(255, 50, 50)
        end
        updateVisuals(active)
        
        btn.MouseButton1Click:Connect(function() 
            active = not active
            if stateObj then stateObj[stateKey] = active end
            updateVisuals(active)
            if callback then callback(active) end
        end)
    else
        if callback then btn.MouseButton1Click:Connect(callback) end
    end
    return btn
end


local function createSlider(text, min, max, stateObj, stateKey, parent, isFloat, callback)
    local f = Instance.new("Frame", parent)
    f.Size = UDim2.new(1, 0, 0, 45); f.BackgroundTransparency = 1
    
    -- Obtener valor inicial
    local currentVal = stateObj and stateObj[stateKey] or (tonumber(stateKey) or min)
    
    local l = Instance.new("TextLabel", f)
    l.Size = UDim2.new(1, -20, 0, 15); l.Position = UDim2.new(0, 15, 0, 5)
    l.TextColor3 = Color3.new(1,1,1); l.BackgroundTransparency = 1; l.Font = "Gotham"; l.TextSize = 10; l.TextXAlignment = "Left"
    
    local b = Instance.new("Frame", f)
    b.Size = UDim2.new(1, -30, 0, 6); b.Position = UDim2.new(0, 15, 0, 25)
    b.BackgroundColor3 = Color3.fromRGB(40,40,40); b.BorderSizePixel = 0
    
    local fill = Instance.new("Frame", b)
    fill.BackgroundColor3 = themeColor; fill.BorderSizePixel = 0
    
    local function setVisual(val)
        local r = math.clamp((val - min) / (max - min), 0, 1)
        fill.Size = UDim2.new(r, 0, 1, 0)
        l.Text = text .. ": " .. (isFloat and string.format("%.1f", val) or tostring(math.floor(val)))
    end
    setVisual(currentVal)

    b.InputBegan:Connect(function(input) 
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            local function update() 
                local mPos = UIS:GetMouseLocation()
                local r = math.clamp((mPos.X - b.AbsolutePosition.X) / b.AbsoluteSize.X, 0, 1)
                local v = min + (r * (max - min))
                local final = isFloat and v or math.floor(v)
                
                if stateObj then stateObj[stateKey] = final end
                setVisual(final)
                if callback then callback(final) end
            end
            local con = UIS.InputChanged:Connect(function(i) 
                if i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch then update() end 
            end)
            local endCon; endCon = UIS.InputEnded:Connect(function(i) 
                if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then 
                    con:Disconnect(); endCon:Disconnect() 
                end 
            end)
            update()
        end 
    end)
end


local function createSub(name, list, stateObj, stateKey, parent, callback)
    local btn = createRow("⚙ "..name .. ": " .. (stateObj and stateObj[stateKey] or stateKey), parent, false, nil, nil, nil, true)
    local con = Instance.new("Frame", parent)
    con.Size = UDim2.new(1,0,0,0); con.BackgroundTransparency = 1; con.ClipsDescendants = true
    Instance.new("UIListLayout", con)
    btn.MouseButton1Click:Connect(function() con.Size = (con.Size.Y.Offset == 0) and UDim2.new(1,0,0,#list*32) or UDim2.new(1,0,0,0) end)
    for i, m in ipairs(list) do
        createRow("  ↳ "..m, con, false, nil, nil, function() 
            if stateObj then stateObj[stateKey] = m else stateKey = m end
            btn.TextLabel.Text = "⚙ "..name .. ": " .. m
            con.Size = UDim2.new(1,0,0,0)
            if callback then callback(i) end
        end, false, true)
    end
end

-- === LÓGICA DE SALA ===
local function teleportToTarget()
    if targetPlayer and targetPlayer.Character then
        local tRoot = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
        local myRoot = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
        if tRoot and myRoot then myRoot.CFrame = tRoot.CFrame * CFrame.new(0, 0, 3) end
    end
end

local function stopAttack()
    local char = LP.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChild("Humanoid")
    flingActive, bangActive = false, false
    if root and hum then
        root.Anchored = true; hum.PlatformStand = true 
        root.Velocity, root.RotVelocity = Vector3.zero, Vector3.zero
        if root:FindFirstChild("FlingForce") then root.FlingForce:Destroy() end
        if lastPos then for i=1,5 do root.CFrame = lastPos RunService.Heartbeat:Wait() end end
        task.wait(0.1); hum.PlatformStand = false; root.Anchored = false
    end
    lastPos = nil
end

local function resetCamera()
    spectateActive = false
    local char = LP.Character
    if char and char:FindFirstChild("Humanoid") then
        Camera.CameraType = Enum.CameraType.Custom
        Camera.CameraSubject = char.Humanoid
    end
end

local function openTarget(p)
    targetPlayer = p
    pages["SALA"].Visible = false
    pages["SALA_OPTS"].Visible = true
    
    for _, v in pairs(pages["SALA_OPTS"]:GetChildren()) do if not v:IsA("UIListLayout") then v:Destroy() end end
    
    createRow("<- VOLVER A SALA", pages["SALA_OPTS"], false, nil, nil, function() 
        resetCamera(); stopAttack(); pages["SALA_OPTS"].Visible = false; pages["SALA"].Visible = true 
    end, false, true).TextLabel.TextColor3 = themeColor
    
    createRow("Espectar", pages["SALA_OPTS"], true, nil, spectateActive, function(v) spectateActive = v if not v then resetCamera() end end)
    createRow("Teletransportar", pages["SALA_OPTS"], false, nil, nil, teleportToTarget, true, true)
    
    createSub("Modo Fling", flingModes, nil, flingModes[flingModeIndex], pages["SALA_OPTS"], function(i) flingModeIndex = i end)
    createRow("Activar Fling", pages["SALA_OPTS"], true, nil, flingActive, function(v) 
        if v then lastPos = LP.Character.HumanoidRootPart.CFrame; flingActive, bangActive = true, false else stopAttack() end 
    end)
    createSlider("Fling Power", 1000, 500000, nil, flingRot, pages["SALA_OPTS"], false, function(v) flingRot = v end)
    
    createSub("Modo Bang", bangModes, nil, bangModes[modeIndex], pages["SALA_OPTS"], function(i) modeIndex = i end)
    createRow("Activar Bang", pages["SALA_OPTS"], true, nil, bangActive, function(v) 
